# OSINT Tools – Environment Variable Configuration
# ─────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Lines starting with # are comments.

# ── IP Geolocation ──────────────────────────────
# Optional: ipgeolocation.io API key for fallback lookups.
# The free ip-api.com endpoint is used by default (no key required).
IPGEOLOCATION_API_KEY=

# ── Have I Been Pwned ───────────────────────────
# Required for breach checking via check_breach().
# Get a key at https://haveibeenpwned.com/API/Key
HIBP_API_KEY=

# ── Logging ─────────────────────────────────────
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL (default: INFO)
OSINT_LOG_LEVEL=INFO
# Path to the log file. Leave empty to disable file logging.
OSINT_LOG_FILE=

# ── Cache ────────────────────────────────────────
# Default time-to-live for cached results, in seconds (default: 3600)
OSINT_CACHE_TTL=3600

# ── HTTP Requests ────────────────────────────────
# Timeout for HTTP requests, in seconds (default: 15)
OSINT_REQUEST_TIMEOUT=15
# Number of retry attempts on transient errors (default: 3)
OSINT_REQUEST_RETRIES=3
# Minimum delay between requests to the same service, in seconds (default: 0.5)
OSINT_RATE_LIMIT_DELAY=0.5
